{
  "$comment": "ChipBench 前端模块清单（唯一事实来源）。tools/check-modules.py --write 据此生成 index.html 的 <script> 列表、js/modules-registry.js 与 docs/MODULES.md；--check 校验顺序 / 依赖 / 文件存在 / 依赖环。layer: kernel 内核 · core 应用壳 · workspace 工作空间 · viewer 文档中心 · engineering 工程中心 · tools 工程工具 · automation 自动化中心 · ux 体验增强。lazy=true 的模块不在启动时加载，由 ChipBench.rt.load(id) 按需加载。",
  "version": 1,
  "modules": [
    { "id": "logic",            "file": "logic.js",            "layer": "kernel",      "deps": [] },
    { "id": "net-logic",        "file": "net-logic.js",        "layer": "kernel",      "deps": [] },
    { "id": "model",            "file": "model.js",            "layer": "kernel",      "deps": ["logic"] },
    { "id": "md",               "file": "md.js",               "layer": "kernel",      "deps": [] },
    { "id": "rt",               "file": "rt.js",               "layer": "kernel",      "deps": [], "note": "运行时服务：统一错误出口、可取消任务、LRU 缓存、性能遥测、模块懒加载" },
    { "id": "core",             "file": "core.js",             "layer": "kernel",      "deps": ["logic", "rt"] },
    { "id": "filesafe",         "file": "filesafe.js",         "layer": "kernel",      "deps": ["core", "rt"], "note": "安全写入：外部修改冲突检测 + 滚动备份 + 恢复" },
    { "id": "modules-registry", "file": "modules-registry.js", "layer": "kernel",      "deps": ["rt"], "note": "由 tools/check-modules.py --write 生成：把本清单交给 rt.modules" },
    { "id": "editor",           "file": "editor.js",           "layer": "core",        "deps": ["core", "md"] },
    { "id": "edit-tools",       "file": "edit-tools.js",       "layer": "core",        "deps": ["editor"] },
    { "id": "app",              "file": "app.js",              "layer": "core",        "deps": ["editor", "rt", "filesafe"] },
    { "id": "index",            "file": "index.js",            "layer": "workspace",   "deps": ["app", "model"] },
    { "id": "workspace",        "file": "workspace.js",        "layer": "workspace",   "deps": ["app", "index", "model"] },
    { "id": "widgets",          "file": "widgets.js",          "layer": "viewer",      "deps": ["app", "workspace"] },
    { "id": "viewers",          "file": "viewers.js",          "layer": "viewer",      "deps": ["widgets"] },
    { "id": "plan",             "file": "plan.js",             "layer": "tools",       "deps": ["viewers", "workspace"] },
    { "id": "learn",            "file": "learn.js",            "layer": "tools",       "deps": ["plan", "viewers"] },
    { "id": "panels",           "file": "panels.js",           "layer": "workspace",   "deps": ["learn", "workspace"] },
    { "id": "tools",            "file": "tools.js",            "layer": "tools",       "deps": ["widgets", "workspace"] },
    { "id": "extras",           "file": "extras.js",           "layer": "tools",       "deps": ["viewers", "workspace"] },
    { "id": "net",              "file": "net.js",              "layer": "tools",       "deps": ["net-logic", "viewers"] },
    { "id": "skills",           "file": "skills.js",           "layer": "automation",  "deps": ["workspace"] },
    { "id": "boot",             "file": "boot.js",             "layer": "core",        "deps": ["panels", "skills", "net", "extras", "tools"], "note": "启动：偏好 → 面板 → 工作区 → 会话恢复。其后的“增强模块”在 boot 之后加载并包装部分函数" },
    { "id": "docs-data",        "file": "docs-data.js",        "layer": "viewer",      "deps": ["core"], "lazy": true, "note": "内置手册文本（≈68 KB），打开帮助中心时才加载" },
    { "id": "integration",      "file": "integration.js",      "layer": "core",        "deps": ["viewers"] },
    { "id": "viewer-pptx",      "file": "viewer-pptx.js",      "layer": "viewer",      "deps": ["integration"], "lazy": true, "note": "PPTX 高保真查看器（≈56 KB），首次打开 .pptx 时加载" },
    { "id": "viewer-html",      "file": "viewer-html.js",      "layer": "viewer",      "deps": ["integration"], "lazy": true, "note": "本地 HTML 查看器（≈13 KB），首次打开 .html 时加载" },
    { "id": "format-toolbar",   "file": "format-toolbar.js",   "layer": "ux",          "deps": ["editor"] },
    { "id": "panels-pro",       "file": "panels-pro.js",       "layer": "tools",       "deps": ["learn", "viewers"] },
    { "id": "help",             "file": "help.js",             "layer": "ux",          "deps": ["integration"] },
    { "id": "workbench",        "file": "workbench.js",        "layer": "workspace",   "deps": ["panels", "workspace", "index"] },
    { "id": "home",             "file": "home.js",             "layer": "ux",          "deps": ["workbench"] },
    { "id": "ipblock",          "file": "ipblock.js",          "layer": "engineering", "deps": ["workbench", "viewers"] },
    { "id": "atlas-model",      "file": "atlas-model.js",      "layer": "engineering", "deps": ["logic"], "note": "IP 图谱统一知识模型：结构/寄存器/场景/时序/代码 + 依据（页码·等级·手册版本）+ 一致性 + 影响分析（纯逻辑，Node 可测）" },
    { "id": "atlas",            "file": "atlas.js",            "layer": "engineering", "deps": ["ipblock", "atlas-model", "home"] },
    { "id": "immersive",        "file": "immersive.js",        "layer": "ux",          "deps": ["workspace"], "note": "全屏 / 专注阅读、柔和界面、打开文件容错（原 v16.js）" },
    { "id": "zoom-hud",         "file": "zoom-hud.js",         "layer": "ux",          "deps": ["home", "atlas"], "note": "统一缩放 HUD + 空闲预热（原 v161.js）" },
    { "id": "docwidth",         "file": "docwidth.js",         "layer": "ux",          "deps": ["workspace"], "note": "文档 / 表格宽度四档、项目树跟随磁盘（原 v162.js）" },
    { "id": "mcp-center",       "file": "mcp-center.js",       "layer": "automation",  "deps": ["filesafe", "docwidth"], "note": "MCP 连接中心 + AI 改动记录（差异 / 撤销 / 自动刷新）" },
    { "id": "diagnostics",      "file": "diagnostics.js",      "layer": "ux",          "deps": ["rt", "workspace", "index"], "note": "耗时探针（打开 / 切换项目 / 切换标签 / 保存 / 索引）+ 诊断与性能报告导出" },
    { "id": "ui-states",        "file": "ui-states.js",        "layer": "ux",          "deps": ["app"], "note": "统一的加载 / 错误 / 空状态（重试、定位、系统程序打开、复制错误）" },
    { "id": "cmd-needs",       "file": "cmd-needs.js",        "layer": "core",        "deps": ["boot", "ui-states"], "note": "命令前提表（有标签 / 有磁盘文件 / 是 Markdown）：不满足时面板隐藏、直接触发时给出原因" }
  ]
}
